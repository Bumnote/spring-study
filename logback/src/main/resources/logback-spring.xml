<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring Boot 기본 로그백 설정(기본 프로퍼티, 컬러 콘솔 패턴 등) 포함 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- application.yml 값을 logback context 프로퍼티로 가져오기 -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="logback"/>

    <!-- 로그 시간을 항상 한국 시간(KST)으로 출력하기 위한 타임존 -->
    <property name="LOG_TIMEZONE" value="Asia/Seoul"/>

    <!-- 1) 사람이 읽기 좋은 콘솔 (로컬 개발용) : MDC의 traceId를 함께 출력 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS, ${LOG_TIMEZONE}} [%thread] [traceId=%X{traceId:-}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2) JSON 콘솔 (운영/구조적 로깅용) : logstash-logback-encoder 사용 -->
    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- @timestamp 를 한국 시간대(+09:00)로 출력 -->
            <timeZone>${LOG_TIMEZONE}</timeZone>
            <!-- MDC에 담긴 traceId를 JSON 필드로 포함 -->
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <!-- 모든 로그에 고정으로 붙일 커스텀 필드 -->
            <customFields>{"app":"${appName}"}</customFields>
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
        </encoder>
    </appender>

    <!-- 프로파일별 분기: local이면 사람이 읽는 로그, 그 외(기본/운영)는 JSON -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>
    </springProfile>

    <springProfile name="!local">
        <root level="INFO">
            <appender-ref ref="STDOUT_JSON"/>
        </root>
    </springProfile>
</configuration>
